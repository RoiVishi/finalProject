# Production settings for the public server.
# On the server:  cp deploy/env.prod.example .env   then fill in every value.
# .env is git-ignored - it never goes to the repository.

# The public name of the server (DuckDNS). Caddy gets the HTTPS certificate for it.
DOMAIN=foresite-sce.duckdns.org

# Random values, each at least 32 characters:  openssl rand -hex 32
JWT_SECRET=
DB_PASSWORD=
