# Builds the frontend and serves it with Caddy. The build context is
# ./frontend (read-only use of that folder; nothing in it is changed).
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
