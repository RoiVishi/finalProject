# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Required. A random value of at least 32 characters, e.g.: openssl rand -hex 32
# The backend refuses to start without it (NFR-SEC-1 / NFR-SEC-2).
JWT_SECRET=

# Required. Shared secret between the backend and the AI service (NFR-SEC-5);
# the AI service refuses to start without it. Same format: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Browser origins allowed to call the API, comma-separated. Never "*".
# Unset = only the local Vite dev server (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
